# Configuración de Variables de Entorno del Backend (BufalosAPI)
# NOTA: En producción, estos valores deben ser provistos por el entorno seguro o Azure Key Vault / Secret Manager

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:51799;http://localhost:51800

# Cadena de conexión SQL Server
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=Bufalos_DB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Configuración JWT (Clave simétrica mínima de 32 caracteres)
Jwt__Key=BufalosSuperSecretKey2026_ClaveMuySegura32Chars
Jwt__Issuer=BufalosApi
Jwt__Audience=BufalosClient
